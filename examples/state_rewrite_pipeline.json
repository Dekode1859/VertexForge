      "temperature": 0.3,
      "tools": [],
      "input_keys": [
        "brief",
        "newsletter_intro"
      ],
      "output_key": "executive_summary"
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "brief_writer"
    },
    {
      "from": "brief_writer",
      "to": "newsletter_writer"
    },
    {
      "from": "newsletter_writer",
      "to": "executive_summarizer"
    },
    {

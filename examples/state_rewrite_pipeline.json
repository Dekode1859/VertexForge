      {
        "name": "source_text",
        "type": "str",
        "default": ""
      },
      {
        "name": "brief",
        "type": "str",
        "default": ""
      },
      {
        "name": "newsletter_intro",
        "type": "str",
        "default": ""
      },
      {
        "name": "executive_summary",
        "type": "str",
        "default": ""
      }
    ]
  },
  "nodes": [
    {
      "node_id": "brief_writer",
      "model": "kimi-k2.5",
      "prompt_ref": {
        "identifier": "vertexforge.brief_writer",
        "tag": "development"
      },
      "temperature": 0.2,
      "tools": [],
